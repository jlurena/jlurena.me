{
  "name": "jlurena.me",
  "version": "2.0",
  "type": "module",
  "author": {
    "name": "Jean Luis Urena"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jlurena/jlurena.me"
  },
  "private": false,
  "description": "Personal website for Jean Luis Urena",
  "license": "UNLICENSED",
  "engines": {
    "npm": "^11.13.0",
    "node": "^26.2"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix && stylelint \"**/*.scss\" --fix",
    "preview": "vite preview",
    "test": "vitest run --environment jsdom",
    "test:coverage": "npm test -- --coverage",
    "test:updatesnapshots": "CI=false vitest --run --update --environment jsdom",
    "test:watch": "vitest --environment jsdom"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
