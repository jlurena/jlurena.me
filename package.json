    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-image-gallery": "^1.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "cubic-bezier": "^0.1.2",
    "fontawesome": "^5.6.3",
    "globals": "^17.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
